# ==============================================================
# Kaizen Production Environment Variables
# ==============================================================
# Copy this file to .env on the EC2 server before deploying:
#   cp .env.production .env
# Then generate real secrets for SECRET_KEY, POSTGRES_PASSWORD, INTERNAL_SECRET
# ==============================================================

# ---- General ----
ENVIRONMENT=production
DEBUG=false

# ---- Django (Service A) ----
SECRET_KEY=CHANGE_ME_generate_with_python_c_from_django_core_management_utils_import_get_random_secret_key_print_get_random_secret_key
ALLOWED_HOSTS=app.kaizenx.in,localhost,127.0.0.1

# ---- CORS / CSRF ----
CORS_ALLOWED_ORIGINS=https://app.kaizenx.in
CSRF_TRUSTED_ORIGINS=https://app.kaizenx.in

# ---- PostgreSQL ----
POSTGRES_DB=kaizen
POSTGRES_USER=kaizen
POSTGRES_PASSWORD=CHANGE_ME_use_a_strong_random_password

# ---- Service B (internal) ----
INTERNAL_SECRET=CHANGE_ME_use_a_strong_random_token
SERVICE_B_TIMEOUT=300
