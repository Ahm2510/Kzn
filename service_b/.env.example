# =============================================================================
# Kaizen Service B - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the appropriate values.
# DO NOT commit .env files with real secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
ENVIRONMENT=development
# ENVIRONMENT=production

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# API key requirement (set to true in production)
API_KEY_REQUIRED=false

# CORS origins (comma-separated, no wildcard in production with credentials)
# REQUIRED in production - app will fail to start without this
CORS_ORIGINS=http://localhost:3000,https://app.kaizen.ai

# Rate limiting (format: "requests/period" e.g., "100/minute", "1000/hour")
RATE_LIMIT=100/minute
ANALYZE_LIMIT=20/minute
RATE_LIMIT_ENABLED=true

# Internal endpoint authentication
# Set a strong random secret for production
INTERNAL_SECRET=change_this

# -----------------------------------------------------------------------------
# Upload Limits
# -----------------------------------------------------------------------------
MAX_UPLOAD_MB=10
MAX_ROWS=200000
MAX_COLUMNS=1000

# -----------------------------------------------------------------------------
# Paths (optional - defaults to ./data)
# -----------------------------------------------------------------------------
# BASE_DATA_PATH=/path/to/data

# -----------------------------------------------------------------------------
# External Services (if needed)
# -----------------------------------------------------------------------------
# CELERY_BROKER_URL=redis://localhost:6379/0
# REDIS_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
