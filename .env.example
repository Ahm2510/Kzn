# ==============================================================
# Kaizen Environment Template
# ==============================================================
# Copy this file to .env before starting containers:
#   cp .env.example .env
# Replace placeholder values with generated strong secrets.
# ==============================================================

# ---- General ----
ENVIRONMENT=production
DEBUG=false

# ---- Django (Service A) ----
SECRET_KEY=YOUR_DJANGO_SECRET_KEY_HERE
ALLOWED_HOSTS=app.kaizenx.in,localhost,127.0.0.1

# ---- CORS / CSRF ----
CORS_ALLOWED_ORIGINS=https://app.kaizenx.in
CSRF_TRUSTED_ORIGINS=https://app.kaizenx.in

# ---- PostgreSQL ----
POSTGRES_DB=kaizen
POSTGRES_USER=kaizen
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE

# ---- Service B (Internal) ----
INTERNAL_SECRET=YOUR_INTERNAL_SECRET_HERE
SERVICE_B_TIMEOUT=300
