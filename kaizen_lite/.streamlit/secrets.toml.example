# Streamlit Cloud Secrets Template
# Copy this to your local .streamlit/secrets.toml for local development
# On Streamlit Cloud, set these in the app's Secrets section

# Database (PostgreSQL)
# Get a free PostgreSQL database from: https://www.elephantsql.com/ or https://neon.tech/
database_url = "postgresql://user:password@host:port/database"

# File Storage (choose one: AWS S3 or Cloudflare R2)

# Option 1: AWS S3
# Create an S3 bucket and IAM user with write permissions
# aws_access_key_id = "your-aws-access-key-id"
# aws_secret_access_key = "your-aws-secret-access-key"
# aws_region = "us-east-1"
# s3_bucket_name = "your-bucket-name"

# Option 2: Cloudflare R2 (Free tier: 10GB storage, 10M operations/month)
# Create account at https://dash.cloudflare.com/ → R2 → Create bucket
# Get R2 API token from https://dash.cloudflare.com/profile/api-tokens
# s3_endpoint_url = "https://<account-id>.r2.cloudflarestorage.com"
# r2_access_key_id = "your-r2-access-key-id"
# r2_secret_access_key = "your-r2-secret-access-key"
# s3_bucket_name = "your-r2-bucket-name"

# Authentication
cookie_secret = "random-secret-key-for-cookies"
admin_secret = "random-secret-key-for-admin-access"

# Firm credentials (add entries for each firm)
[credentials.usernames.example_firm]
email = "firm@example.com"
name = "Example Firm"
password = "hashed_password_here"

# To hash a password, run:
# python -c "import streamlit_authenticator; print(streamlit_authenticator.Hasher(['your_password']).generate()[0])"
